# Public, browser-safe project configuration. This template contains no values.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Production build only; Actions obtains this from configure-pages.base_url.
# PUBLIC_SITE_URL=https://your-account.github.io/sahoo-academy/

# Set these ONLY in Supabase Edge Function secrets, never in a browser bundle:
# ALLOWED_ORIGINS=https://your-final-domain.example,http://127.0.0.1:4173
# TELEGRAM_BOT_TOKEN=<BotFather token>
# TELEGRAM_BOT_USERNAME=<bot username without @>
# Telegram channel ID/URL and requirement scope are set in private Admin Launch settings.
# TELEGRAM_WEBHOOK_SECRET=<random secret>
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into hosted Edge Functions.
